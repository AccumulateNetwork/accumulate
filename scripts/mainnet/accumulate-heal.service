# systemd unit for the mainnet synthetic-transaction healer (#4064 stopgap).
# Install: cp to /etc/systemd/system/, then
#   systemctl daemon-reload && systemctl enable --now accumulate-heal
# Runs on the operator box, NOT the validator.
[Unit]
Description=Accumulate mainnet synthetic-transaction healer (#4064)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/heal-synth.sh
Restart=always
RestartSec=30
# Reaches mainnet over the public API + p2p; no keys required (re-submits
# already-signed synthetics). Runs as an unprivileged user.
DynamicUser=yes
StateDirectory=accumulate-heal
Environment=CACHE=/var/lib/accumulate-heal

[Install]
WantedBy=multi-user.target
